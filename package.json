{
  "name": "eden-backend",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node index.js",
    "dev": "cross-env NODE_ENV=development nodemon index.js",
    "test": "cross-env NODE_ENV=test jest --verbose --runInBand --forceExit",
    "lint": "eslint .",
    "start:auth": "node ./auth/index.js",
    "start:product": "node ./product/index.js",
    "start:order": "node ./order/index.js",
    "start:notification": "node ./notification/index.js",
    "start:user": "node ./user/index.js",
    "start:services": "concurrently \"npm run start:auth --watch\" \"npm run start:user --watch\" \"npm run start:product --watch\" \"npm run start:order --watch\" \"npm run start:notification --watch\""
  },
  "author": "Stephen Wayar",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.31.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.17.3",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.2.7",
    "morgan": "^1.10.0",
    "nodemailer": "^6.7.8",
    "nodemon": "^2.0.15",
    "twilio": "^3.84.1"
  },
  "devDependencies": {
    "eslint": "^8.16.0",
    "jest": "^28.1.0",
    "supertest": "^6.2.4",
    "concurrently": "^9.0.1"
  }
}
